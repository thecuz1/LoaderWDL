# top-most EditorConfig file
root = true

[*]
    end_of_line = lf
    insert_final_newline = true

[Makefile, *.mk]
    indent_style = tab

[.editorconfig]
    indent_style = tab

[*.{cpp,hpp,c,h}]
    indent_style = tab
    indent_size = 4

[*.lua]
    indent_style = tab
    indent_size = 2

[*.yaml]
    indent_style = space
    indent_size = 2
